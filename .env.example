# ---- Banco de dados ----
# Local (via docker-compose): postgres rodando em localhost:5432
DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5432/ecommerce?schema=public"

# ---- Servidor ----
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# ---- Segredos ----
# JWT usado para autenticar o CLIENTE FINAL do e-commerce (os compradores do app dos alunos)
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="7d"

# Token mestre de ADMIN (SÓ você, o professor). Usado no header X-Admin-Token
# para criar grupos, gerar chaves e ver os logs de atividade.
ADMIN_TOKEN="troque-este-token-de-admin-super-secreto"

# ---- CORS ----
# API dos alunos (/v1/*): aberta, para consumirem via API key/SDK de qualquer origem
# (browser ou servidor). Não é falha de segurança: a auth é por header/API key, sem cookie.
CORS_ORIGIN="*"
# Control plane (/admin/*): restrito ao painel do professor (lista separada por vírgula).
# Se vazio, herda o CORS_ORIGIN geral (útil em dev). Em produção, aponte para a URL do painel.
ADMIN_CORS_ORIGIN="https://professor.mockmerce.com.br"

# ---- Estoque ----
# Minutos que uma reserva de estoque (feita no checkout) dura antes de expirar
# e ser liberada automaticamente pelo job. Padrão: 30.
RESERVATION_TTL_MINUTES=30
# Minutos sem atividade para um carrinho ser marcado como abandonado. Padrão: 60.
ABANDON_TTL_MINUTES=60

# ---- Webhooks ----
# Máximo de tentativas de entrega antes de marcar como dead-letter. Padrão: 5.
WEBHOOK_MAX_ATTEMPTS=5

# ---- Segurança de plataforma ----
# Limite de requisições por minuto POR grupo (X-API-Key). Padrão: 300.
RATE_LIMIT_PER_MINUTE=300
# DEV apenas: "true" permite webhooks para http/localhost (para testar receptor
# local). Em produção deixe "false" — o guard anti-SSRF bloqueia interno/metadata.
WEBHOOK_ALLOW_INSECURE_TARGETS=false
