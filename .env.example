# ---- Banco de dados ----
# Local (via docker-compose): postgres rodando em localhost:5432
DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5432/ecommerce?schema=public"

# ---- Servidor ----
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# ---- Segredos ----
# JWT usado para autenticar o CLIENTE FINAL do e-commerce (os compradores do app dos alunos)
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="7d"

# Token mestre de ADMIN (SÓ você, o professor). Usado no header X-Admin-Token
# para criar grupos, gerar chaves e ver os logs de atividade.
ADMIN_TOKEN="troque-este-token-de-admin-super-secreto"

# ---- CORS ----
# API dos alunos (/v1/*): aberta, para consumirem via API key/SDK de qualquer origem
# (browser ou servidor). Não é falha de segurança: a auth é por header/API key, sem cookie.
CORS_ORIGIN="*"
# Control plane (/admin/*): restrito ao painel do professor (lista separada por vírgula).
# Se vazio, herda o CORS_ORIGIN geral (útil em dev). Em produção, aponte para a URL do painel.
ADMIN_CORS_ORIGIN="https://professor.mockmerce.com.br"

# ---- Estoque ----
# Minutos que uma reserva de estoque (feita no checkout) dura antes de expirar
# e ser liberada automaticamente pelo job. Padrão: 30.
RESERVATION_TTL_MINUTES=30
# Minutos sem atividade para um carrinho ser marcado como abandonado. Padrão: 60.
ABANDON_TTL_MINUTES=60

# ---- Webhooks ----
# Máximo de tentativas de entrega antes de marcar como dead-letter. Padrão: 5.
WEBHOOK_MAX_ATTEMPTS=5

# ---- Segurança de plataforma ----
# Limite de requisições por minuto POR grupo (X-API-Key). Padrão: 300.
RATE_LIMIT_PER_MINUTE=300
# DEV apenas: "true" permite webhooks para http/localhost (para testar receptor
# local). Em produção deixe "false" — o guard anti-SSRF bloqueia interno/metadata.
WEBHOOK_ALLOW_INSECURE_TARGETS=false

# ---- Upload de mídia (S3) ----
# Bucket onde as imagens/vídeos das lojas ficam guardados.
# SEM S3_BUCKET, as rotas de upload respondem 503 UPLOAD_DISABLED e o resto
# da API continua funcionando normalmente.
S3_BUCKET="mockmerce-media"
AWS_REGION="us-east-1"
# Credenciais do usuário IAM que só pode gravar/apagar neste bucket.
# Em produção (EC2/ECS), prefira deixar VAZIO e usar a role da instância.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Endpoint alternativo compatível com S3 (MinIO, LocalStack, Cloudflare R2).
# Vazio = AWS.
S3_ENDPOINT=""
# Base pública das URLs devolvidas (CloudFront ou domínio próprio), SEM barra final.
# Vazio = URL direta do bucket (https://<bucket>.s3.<region>.amazonaws.com/<key>).
S3_PUBLIC_BASE_URL=""
# ACL do objeto. Buckets novos têm ACL desabilitada (o acesso público vem da
# bucket policy) — deixe vazio. Use "public-read" só em bucket legado.
S3_OBJECT_ACL=""
# Tamanho máximo de UM arquivo, em MB.
UPLOAD_MAX_MB=50
# Cota total de storage POR GRUPO, em MB (evita um grupo encher o bucket).
UPLOAD_QUOTA_MB_PER_GROUP=500

# ---------------------------------------------------------------------------
# PUSH — Firebase Cloud Messaging (HTTP v1)
# ---------------------------------------------------------------------------
# Sem credencial, a API inteira continua de pé e só as rotas de push respondem
# 503 PUSH_DISABLED. Confira com GET /v1/push/status.
#
# Como obter (uma vez, um projeto Firebase para a turma toda):
#   1. console.firebase.google.com -> criar projeto
#   2. adicionar um app Android com o package do app (br.com.fiap.vitrine)
#      e baixar o google-services.json (esse arquivo vai no APP, não aqui)
#   3. Configurações do projeto -> Contas de serviço -> "Gerar nova chave
#      privada" -> baixa um JSON
#   4. base64 -i chave.json | pbcopy   e cole em FCM_SERVICE_ACCOUNT_JSON
#
# Forma 1 (recomendada): o JSON inteiro em base64, numa variável só.
FCM_SERVICE_ACCOUNT_JSON=""
# Forma 2: os três campos soltos (use ou esta, ou a de cima — não as duas).
# No FCM_PRIVATE_KEY mantenha os \n literais entre aspas; o servidor converte.
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""
# Canal padrão do Android quando o envio não especifica um. O canal precisa
# EXISTIR no app (Notifications.setNotificationChannelAsync).
PUSH_ANDROID_CHANNEL_ID="default"
# Quantos aparelhos recebem em paralelo num disparo (o FCM v1 manda 1 por vez).
PUSH_CONCURRENCY=8
